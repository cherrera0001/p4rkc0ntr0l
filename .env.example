# Plantilla de variables de entorno. Copiar a .env y completar.
# NUNCA versionar .env ni .env.local — están en .gitignore (spec.md §7).

# Cadena de conexión de Postgres en Railway (ADR-003).
#
# Usar la URL del TCP proxy PÚBLICO (Railway → servicio Postgres → Settings →
# Public Networking, o la variable DATABASE_PUBLIC_URL). La URL de la red
# privada (*.railway.internal) no resuelve desde Vercel.
#
# Incluir siempre ?sslmode=require.
DATABASE_URL=

# Clave HMAC para firmar la cookie de sesión. Valor largo y aleatorio.
SESSION_SECRET=

# Clave de acceso compartida del piloto.
CLAVE_ACCESO=

# BARRERA DE CUMPLIMIENTO — dejar en false / sin definir.
# Con esto apagado el sistema solo acepta patentes de prueba (prefijo FIXT).
# Encenderlo habilita el tratamiento de patentes REALES, que son datos personales
# bajo la Ley 21.719, y eso exige tener definidos antes:
#   {{BASE_LICITUD}} y {{PLAZO_RETENCION_PATENTE}}  (spec.md §4 y §12)
# No lo enciendas hasta que ambos estén resueltos.
OPERACION_REAL_HABILITADA=false
