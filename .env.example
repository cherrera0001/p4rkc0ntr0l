# Plantilla de variables de entorno. Copiar a .env y completar.
# NUNCA versionar .env ni .env.local — están en .gitignore (spec.md §7).

# Cadena de conexión de Postgres en Railway (ADR-003).
#
# Usar la URL del TCP proxy PÚBLICO (Railway → servicio Postgres → Settings →
# Public Networking, o la variable DATABASE_PUBLIC_URL). La URL de la red
# privada (*.railway.internal) no resuelve desde Vercel.
#
# Incluir siempre ?sslmode=require.
DATABASE_URL=

# Clave HMAC para firmar la cookie de sesión. Valor largo y aleatorio.
SESSION_SECRET=

# Clave de acceso compartida del piloto.
CLAVE_ACCESO=

# BARRERA DE CUMPLIMIENTO — dejar en false / sin definir.
# Con esto apagado el sistema solo acepta patentes de prueba (prefijo FIXT).
# Encenderlo habilita el tratamiento de patentes REALES, que son datos personales
# bajo la Ley 21.719, y eso exige tener definidos antes:
#   {{BASE_LICITUD}} y {{PLAZO_RETENCION_PATENTE}}  (spec.md §4 y §12)
# No lo enciendas hasta que ambos estén resueltos.
OPERACION_REAL_HABILITADA=false

# ---------------------------------------------------------------------------
# DATOS DE PRUEBA (fixtures)
# ---------------------------------------------------------------------------
# Los lee `scripts/sembrar.mjs` y los verificadores, desde
# `scripts/lib/fixtures.mjs` — un solo lugar. Los valores de abajo son los
# defaults: si no definís nada, el sistema siembra exactamente eso.
#
# Una variable presente pero VACÍA cuenta como ausente y se usa el default; es
# la misma regla de `leerEnv()` en `src/lib/env.ts`. Un valor presente pero
# inválido (un entero que no lo es, una zona horaria que no existe) **falla**,
# no se sustituye en silencio: sustituirlo hacía que la configuración escrita
# nunca se aplicara y que las pruebas siguieran pasando igual.
#
# `spec.md` §11 exige que los datos de prueba se VEAN como datos de prueba.
# `sembrar.mjs` lo comprueba y falla si un email no termina en `.invalid`
# (dominio reservado por RFC 2606, nunca resoluble). No es una convención: es
# un chequeo, porque mover estos valores a configuración abrió la posibilidad
# de sembrar algo que parezca real.
#
# CÓMO ENTRAR A LA APP: el email identifica al usuario y su rol; CLAVE_ACCESO
# es la barrera y es LA MISMA para los dos. No hay clave por usuario — es la
# limitación declarada de la auth mínima de M3.
EMAIL_OPERADOR=operador@fixture.invalid
EMAIL_DUENO=duena@fixture.invalid

# Estacionamiento de prueba.
FIXTURE_NOMBRE_ESTACIONAMIENTO=Estacionamiento de prueba (fixture)
FIXTURE_CAPACIDAD_TOTAL=20
FIXTURE_ZONA_HORARIA=America/Santiago

# Tarifa de prueba. Montos redondos a propósito. Con estos valores,
# 89 min -> 90 min -> $1500, que es lo que verifica verificar-salida.mjs.
FIXTURE_VALOR_HORA=1000
FIXTURE_FRACCION_MINUTOS=15
FIXTURE_MONTO_MINIMO=500
FIXTURE_VIGENTE_DESDE=2026-01-01T00:00:00.000Z

# Patentes de prueba: el prefijo es `FIXT` (FIXT01, FIXT32, …).
# NO se configura por entorno, y es deliberado: ese prefijo es la barrera de
# cumplimiento de A-3, no un ajuste. Vive en `src/lib/fixtures.ts`, porque una
# barrera que se afloja con una variable de entorno no es una barrera.

# URL de producción, para correr los verificadores contra el deploy.
# Sin argumento, corren contra localhost:3000.
URL_PRODUCCION=
